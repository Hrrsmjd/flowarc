# Copy to .env and fill in. NEVER commit .env.

# --- Gemini / Google DeepMind ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-argon
# Antigravity managed-agent sandbox (from the DeepMind booth)
ANTIGRAVITY_API_KEY=
ANTIGRAVITY_MODEL=antigravity-preview-09-2026

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=flowforge
# Voyage AI (embeddings for vector search) — optional
VOYAGE_API_KEY=

# --- run config ---
LOOP_INTERVAL_SECONDS=0
MAX_SAMPLES=0        # 0 = unbounded
SOLVER_MAX_ITERS=2000
CONVERGENCE_TOL=1e-4
