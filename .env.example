# Copy to .env and fill in. Never commit .env.

GEMINI_API_KEY=
FLOWARC_LEAD_MODEL=gemini-4-argon
FLOWARC_FAST_MODEL=gemini-3.8-flash
FLOWARC_IMAGE_MODEL=gemini-nano-banana-2.1
FLOWARC_EMBED_MODEL=gemini-embedding-2

# Where all samples go. On w7830 this must be inside ~/RDS.
FLOWARC_DATA=./data
# pilot | first | reference (see flowarc/config.py)
FLOWARC_PHASE=pilot
# GPUs the pipeline may use, comma separated
FLOWARC_GPUS=0

# MongoDB Atlas registry (samples, logs, concept vectors). Empty = local JSON files.
MONGODB_URI=
MONGODB_DB=flowarc
# Voyage AI model for Atlas Automated Embedding (search); novelty uses FLOWARC_EMBED_MODEL
FLOWARC_AUTO_EMBED_MODEL=voyage-4

# Optional
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Private HF dataset for sample files (views, mesh, video, Zarr)
FLOWARC_HF_REPO=hrrsmjd/flowarc-pilot
HF_TOKEN=
