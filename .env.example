# Copy to .env and fill in. Never commit .env.

GEMINI_API_KEY=
FLOWARC_LEAD_MODEL=gemini-4-argon
FLOWARC_FAST_MODEL=gemini-3.8-flash
FLOWARC_IMAGE_MODEL=gemini-nano-banana-2.1
FLOWARC_EMBED_MODEL=gemini-embedding-2

# Where all samples go. On w7830 this must be inside ~/RDS.
FLOWARC_DATA=./data
# pilot | first | reference (see flowarc/config.py)
FLOWARC_PHASE=pilot
# GPUs the pipeline may use, comma separated
FLOWARC_GPUS=0

# Optional
MONGODB_URI=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
